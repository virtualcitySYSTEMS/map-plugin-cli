{
  "name": "@vcmap/plugin-cli",
  "version": "5.0.0-rc.0",
  "description": "A CLI to help develop and build plugins for the VC Map",
  "main": "index.js",
  "type": "module",
  "bin": {
    "vcmplugin": "cli.js"
  },
  "scripts": {
    "lint:js": "eslint . --ext .vue,.js,.cjs,.mjs,.ts,.cts,.mts",
    "lint:prettier": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:prettier",
    "format": "prettier --write --list-different . && npm run lint:js -- --fix",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/virtualcitySYSTEMS/map-plugin-cli.git"
  },
  "author": "Ben Kuster <bkuster@virtualcitysystems.de>",
  "license": "MIT",
  "files": [
    "assets/",
    "src/",
    "cli.js",
    "README.md",
    "index.js",
    "LICENSE.md"
  ],
  "dependencies": {
    "@vcmap/rollup-plugin-vcs-ol": "^1.0.2",
    "@vcsuite/cli-logger": "^1.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "commander": "^10.0.1",
    "express": "^4.21.1",
    "prompts": "^2.4.2",
    "sass": "^1.80.2",
    "semver": "^7.5.4",
    "tar": "^7.5.11",
    "vite": "^8.2.0",
    "vite-plugin-vuetify": "~2.0.4"
  },
  "peerDependencies": {
    "@vcmap/ui": "^7.0.0-rc.1",
    "vue": "~3.4.38",
    "vuetify": "~3.7.14"
  },
  "peerDependenciesMeta": {
    "@vcmap/ui": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vuetify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vcsuite/eslint-config": "^4.0.0"
  },
  "prettier": "@vcsuite/eslint-config/prettier.js",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
